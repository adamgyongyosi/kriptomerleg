{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kriptomérleg",
  "version": "0.3.0",
  "identifier": "hu.kriptoado.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kriptomérleg",
        "width": 1180,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Magyar kriptó-SZJA kalkulátor, helyben futó asztali app",
    "category": "Finance",
    "longDescription": "Kriptó befizetések és kivételek nyilvántartása, MNB árfolyamon számolt 15% SZJA, tőzsdei import és NAV-bevallási segéd. Minden adat a saját gépeden marad.",
    "publisher": "Kriptomérleg",
    "homepage": "https://adamgyongyosi.github.io/kripto-ado/"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2RkVBQUEyRDAyMTc2MDYKUldRR2RpSFFvcXIrSnBjN01yZldDZ2hsaUprUWtQaDd4b05qUmRHeWRoTGFsa2hST1lIOTA0eTUK",
      "endpoints": [
        "https://github.com/adamgyongyosi/kripto-ado/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
