{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kripto adó",
  "version": "0.2.0",
  "identifier": "hu.kriptoado.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kripto adó – befizetések és SZJA",
        "width": 1180,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Kripto befizetések és SZJA számítás MNB árfolyamon",
    "category": "Finance"
  }
}
